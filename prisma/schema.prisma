// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
  seed     = "ts-node --transpile-only prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

// ================================================================
//                       ACCOUNTING LAYER (§5.1)
// Double-entry general ledger. Every business event (sale, purchase,
// payment) emits a balanced `JournalEntry` whose `JournalLine` rows
// sum (Σ debits = Σ credits). Reports (P&L, balance sheet, trial
// balance) are then "select sum(debit) - sum(credit) from
// journal_lines where accountId = ..." aggregates.
// ================================================================
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id        Int         @id @default(autoincrement())
  code      String
  name      String
  type      AccountType
  parentId  Int?
  isActive  Boolean     @default(true)
  notes     String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  parent   Account?      @relation("AccountParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Account[]     @relation("AccountParent")
  lines    JournalLine[]

  deletedAt DateTime?

  @@unique([code])

  @@index([type])
  @@index([parentId])
  @@index([deletedAt])
  @@map("accounts")
}

model JournalEntry {
  id          Int       @id @default(autoincrement())
  entryNo     String
  date        DateTime
  description String
  sourceType  String?
  sourceId    Int?
  isLocked    Boolean   @default(false)
  lockedAt    DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lines   JournalLine[]

  deletedAt DateTime?

  @@unique([entryNo])

  @@index([date])
  @@index([sourceType, sourceId])
  @@index([deletedAt])
  @@map("journal_entries")
}

model JournalLine {
  id             Int     @id @default(autoincrement())
  journalEntryId Int
  accountId      Int
  debit          Float   @default(0)
  credit         Float   @default(0)
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  deletedAt DateTime?

  @@index([journalEntryId])
  @@index([accountId])

  @@index([deletedAt])
  @@map("journal_lines")
}

// ================================================================
//                  BANK RECONCILIATION MODULE (§5.2)
// Workflow:
//   1. Operator imports a bank statement → creates BankTransaction rows.
//   2. Operator (or scheduled job) runs auto-match: link bank rows to
//      Payment (incoming) / SupplierPayment (outgoing) by amount +
//      date window + reference.
//   3. Unmatched rows go to a manual matcher UI.
//   4. Operator closes the reconciliation for the period, locking it.
// ================================================================
enum BankTransactionDirection {
  CREDIT // money INTO the bank account
  DEBIT  // money OUT of the bank account
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum ReconciliationStatus {
  OPEN
  COMPLETED
}

model BankAccount {
  id             Int      @id @default(autoincrement())
  name           String
  accountNumber  String?
  currency       String   @default("USD")
  provider       String?
  openingBalance Float    @default(0)
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions    BankTransaction[]
  reconciliations Reconciliation[]

  deletedAt DateTime?

  @@unique([name])

  @@index([deletedAt])
  @@map("bank_accounts")
}

model BankTransaction {
  id                       Int                      @id @default(autoincrement())
  bankAccountId            Int
  statementDate            DateTime
  direction                BankTransactionDirection
  amount                   Float
  description              String?
  reference                String?
  raw                      Json?
  status                   BankTransactionStatus    @default(UNMATCHED)
  matchedPaymentId         Int?
  matchedSupplierPaymentId Int?
  matchedAt                DateTime?
  matchedBy                String?
  importedAt               DateTime                 @default(now())

  bankAccount            BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  matchedPayment         Payment?         @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  matchedSupplierPayment SupplierPayment? @relation(fields: [matchedSupplierPaymentId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  @@index([bankAccountId])
  @@index([statementDate])
  @@index([status])
  @@index([matchedPaymentId])
  @@index([matchedSupplierPaymentId])
  @@index([status, statementDate])
  @@index([deletedAt])
  @@map("bank_transactions")
}

model Reconciliation {
  id             Int                  @id @default(autoincrement())
  bankAccountId  Int
  periodStart    DateTime
  periodEnd      DateTime
  status         ReconciliationStatus @default(OPEN)
  openingBalance Float
  closingBalance Float
  notes          String?              @db.Text
  createdBy      String?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([bankAccountId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([deletedAt])
  @@map("reconciliations")
}

model User {
  id              Int          @id @default(autoincrement())
  name            String
  email           String       @unique
  password        String?
  googleId        String?      @unique
  profile_picture String?
  isActive        Boolean      @default(true)
  userRole        UserRole     @default(USER)
  roles           Role[]       @relation("UserRoles")
  permissions     Permission[]
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  created_by      Int?
  updated_by      Int?

  created_by_user User?    @relation("UserCreatedBy", fields: [created_by], references: [id])
  updated_by_user User?    @relation("UserUpdatedBy", fields: [updated_by], references: [id])

  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  created_roles Role[] @relation("CreatedRoles")

  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       User[]       @relation("UserRoles")
  created_by  Int
  created_at  DateTime     @default(now())

  created_by_user User @relation("CreatedRoles", fields: [created_by], references: [id])

  @@map("roles")
}

model Permission {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  group_name String
  label      String
  roles      Role[]   @relation("RolePermissions")
  created_at DateTime @default(now())

  created_by Int?
  user       User? @relation(fields: [created_by], references: [id])

  @@index([created_by])
  @@map("permissions")
}

// ================================================================
//                     INVENTORY MANAGEMENT MODULE
// ================================================================

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum StockMovementReference {
  PURCHASE
  SALE
  MANUAL
  TRANSFER
  ADJUSTMENT
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum AlertType {
  LOW_STOCK
  OVERSTOCK
  DEAD_STOCK
  REORDER
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Item {
  id              Int          @id @default(autoincrement())
  name            String
  sku             String?
  unit            String       @default("pcs")
  description     String?      @db.Text
  minStock        Float        @default(0)
  maxStock        Float?
  reorderPoint    Float?
  reorderQuantity Float?
  leadTimeDays    Int?
  salePrice       Float        @default(0)
  purchasePrice   Float        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  stocks          InventoryStock[]
  movements       StockMovement[]
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  batches         InventoryBatch[]
  alerts          Alert[]
  stockCountLines StockCountLine[]

  deletedAt DateTime?

  @@unique([sku])
  @@index([name])
  @@index([deletedAt])
  // Item-list search + filter sorts by name within the tenant.
  @@map("items")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks          InventoryStock[]
  sourceMovements StockMovement[]  @relation("SourceWarehouse")
  targetMovements StockMovement[]  @relation("TargetWarehouse")
  batches         InventoryBatch[]
  alerts          Alert[]
  stockCounts     StockCount[]

  deletedAt DateTime?

  @@index([deletedAt])
  @@map("warehouses")
}

model InventoryStock {
  id          Int      @id @default(autoincrement())
  itemId      Int
  warehouseId Int
  quantity    Float    @default(0)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@index([warehouseId])

  @@index([deletedAt])
  // Tenant-scoped per-item stock aggregates (used in low-stock + dead-stock
  // subqueries) benefit from a companyId-first composite.
  @@map("inventory_stock")
}

model InventoryBatch {
  id          Int       @id @default(autoincrement())
  itemId      Int
  warehouseId Int
  batchNo     String?
  quantity    Float     @default(0)
  unitCost    Float     @default(0)
  receivedAt  DateTime  @default(now())
  expiryDate  DateTime?
  purchaseId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  @@index([itemId, warehouseId])
  @@index([receivedAt])
  @@index([expiryDate])
  @@index([purchaseId])

  @@index([deletedAt])
  @@map("inventory_batches")
}

model StockMovement {
  id                Int                    @id @default(autoincrement())
  itemId            Int
  type              StockMovementType
  quantity          Float
  unitCost          Float?
  batchId           Int?
  sourceWarehouseId Int?
  targetWarehouseId Int?
  referenceType     StockMovementReference @default(MANUAL)
  referenceId       Int?
  purchaseId        Int?
  userId            Int?
  idempotencyKey    String?                @unique
  notes             String?                @db.Text
  createdAt         DateTime               @default(now())

  item            Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  targetWarehouse Warehouse? @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: SetNull)
  purchase        Purchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
  @@index([purchaseId])
  @@index([referenceType, referenceId])

  @@index([deletedAt])
  // Composite indexes for the heavy raw SQL in inventory reports:
  //  - dead-stock + monthly-usage scans filter by companyId + type + createdAt.
  //  - last-OUT-per-item lookups filter by companyId + itemId + createdAt.
  //  - sale-COGS joins filter by companyId + (referenceType, referenceId).
  @@index([type, createdAt])
  @@index([itemId, createdAt])
  @@map("stock_movements")
}

model Alert {
  id           Int         @id @default(autoincrement())
  type         AlertType
  status       AlertStatus @default(OPEN)
  itemId       Int
  warehouseId  Int?
  message      String      @db.Text
  threshold    Float?
  currentValue Float?
  metadata     Json?
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
  /// First time the alert was dispatched to any notification channel.
  /// `dispatchOpen()` skips alerts where this is set so cron re-runs
  /// don't double-notify (§5.3).
  dispatchedAt DateTime?

  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  @@index([type])
  @@index([status])
  @@index([itemId])
  @@index([warehouseId])
  @@index([createdAt])

  @@index([deletedAt])
  @@index([status, dispatchedAt])
  @@map("alerts")
}

model StockCount {
  id          Int              @id @default(autoincrement())
  reference   String?
  warehouseId Int
  status      StockCountStatus @default(DRAFT)
  notes       String?          @db.Text
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  createdBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines     StockCountLine[]

  deletedAt DateTime?

  @@unique([reference])
  @@index([warehouseId])
  @@index([status])
  @@index([startedAt])

  @@index([deletedAt])
  @@map("stock_counts")
}

model StockCountLine {
  id           Int     @id @default(autoincrement())
  stockCountId Int
  itemId       Int
  expectedQty  Float   @default(0)
  countedQty   Float   @default(0)
  variance     Float   @default(0)
  notes        String? @db.Text

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@unique([stockCountId, itemId])
  @@index([stockCountId])
  @@index([itemId])

  @@index([deletedAt])
  @@map("stock_count_lines")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  totalOwed Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  payments  SupplierPayment[]

  deletedAt DateTime?

  @@index([deletedAt])
  @@map("suppliers")
}

model Purchase {
  id              Int            @id @default(autoincrement())
  supplierId      Int?
  referenceNo     String?
  totalAmount     Float          @default(0)
  paidAmount      Float          @default(0)
  remainingAmount Float          @default(0)
  paymentStatus   PaymentStatus  @default(UNPAID)
  purchaseDate    DateTime       @default(now())
  status          PurchaseStatus @default(PENDING)
  notes           String?        @db.Text
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  supplier  Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items     PurchaseItem[]
  movements StockMovement[]
  payments  SupplierPayment[]
  batches   InventoryBatch[]

  deletedAt DateTime?

  @@index([supplierId])
  @@index([status])
  @@index([paymentStatus])
  @@index([purchaseDate])

  @@index([deletedAt])
  // Sales-report "purchases by period" aggregate + AP dashboard both
  // filter by tenant + status + purchaseDate.
  @@index([status, purchaseDate])
  @@map("purchases")
}

model SupplierPayment {
  id          Int           @id @default(autoincrement())
  supplierId  Int
  purchaseId  Int?
  amount      Float
  method      PaymentMethod @default(CASH)
  paymentDate DateTime      @default(now())
  referenceNo String?
  notes       String?       @db.Text
  createdBy   String?
  createdAt   DateTime      @default(now())

  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchase         Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  bankTransactions BankTransaction[]

  deletedAt DateTime?

  @@index([supplierId])
  @@index([purchaseId])
  @@index([paymentDate])

  @@index([deletedAt])
  @@map("supplier_payments")
}

model PurchaseItem {
  id         Int   @id @default(autoincrement())
  purchaseId Int
  itemId     Int
  quantity   Float
  price      Float @default(0)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([purchaseId])
  @@index([itemId])

  @@index([deletedAt])
  @@map("purchase_items")
}

// ================================================================
//             SALES / BILLING / PAYMENTS MODULE
// ================================================================

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE
  CREDIT
  OTHER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  creditLimit Float    @default(0)
  totalOwed   Float    @default(0)
  notes       String?  @db.Text
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales   Sale[]

  deletedAt DateTime?

  @@index([name])
  @@index([phone])

  @@index([deletedAt])
  // Customer-list search sorted by createdAt is tenant-scoped.
  @@map("customers")
}

model Sale {
  id              Int           @id @default(autoincrement())
  invoiceNo       String
  customerId      Int?
  warehouseId     Int
  subtotal        Float         @default(0)
  discount        Float         @default(0)
  tax             Float         @default(0)
  totalAmount     Float         @default(0)
  paidAmount      Float         @default(0)
  remainingAmount Float         @default(0)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod @default(CASH)
  saleStatus      SaleStatus    @default(COMPLETED)
  saleDate        DateTime      @default(now())
  dueDate         DateTime?
  notes           String?       @db.Text
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  payments Payment[]

  deletedAt DateTime?

  @@unique([invoiceNo])
  @@index([invoiceNo])
  @@index([customerId])
  @@index([paymentStatus])
  @@index([saleDate])

  @@index([deletedAt])
  // Composite indexes for hot report paths. Every report filters by
  // tenant first, so leading with companyId lets these indexes also
  // satisfy companyId-only queries via left-prefix scan.
  @@index([paymentStatus, dueDate])
  @@index([customerId, saleDate])
  @@index([saleStatus, saleDate])
  @@map("sales")
}

model SaleItem {
  id        Int   @id @default(autoincrement())
  saleId    Int
  itemId    Int
  quantity  Float
  unitPrice Float @default(0)
  discount  Float @default(0)
  lineTotal Float @default(0)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  deletedAt DateTime?

  @@index([saleId])
  @@index([itemId])

  @@index([deletedAt])
  @@map("sale_items")
}

model Payment {
  id          Int           @id @default(autoincrement())
  saleId      Int
  amount      Float
  method      PaymentMethod @default(CASH)
  paymentDate DateTime      @default(now())
  referenceNo String?
  notes       String?       @db.Text
  createdBy   String?
  createdAt   DateTime      @default(now())

  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  bankTransactions BankTransaction[]

  deletedAt DateTime?

  @@index([saleId])
  @@index([paymentDate])

  @@index([deletedAt])
  // Dashboard "cash received this month / period" aggregates filter
  // by companyId + paymentDate range.
  @@map("payments")
}
