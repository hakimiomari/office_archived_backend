// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
    seed     = "ts-node --transpile-only prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String?
  googleId        String? @unique
  profile_picture  String?
  isActive        Boolean  @default(true)
  roles           Role[]   @relation("UserRoles")
  permissions     Permission[]
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       Int?
  updated_by       Int?


  created_by_user User? @relation("UserCreatedBy", fields: [created_by], references: [id])
  updated_by_user User? @relation("UserUpdatedBy", fields: [updated_by], references: [id])


  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  created_roles    Role[] @relation("CreatedRoles")
  archives_update_by Archives[] @relation("archived_updated_by")
  archives_created_by Archives[] @relation("archived_created_by")

  @@map("users") // This is optional, but if you want to map it to 'users', you can use this

}

model Role {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  description  String?
  permissions  Permission[] @relation("RolePermissions")
  users        User[]       @relation("UserRoles")
  created_by   Int
  created_at   DateTime     @default(now())

  created_by_user User @relation("CreatedRoles", fields: [created_by], references: [id])


  @@map("roles")
}

model Permission {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  group_name String
  label String
  roles Role[]  @relation("RolePermissions")
  created_at DateTime @default(now())

  created_by Int?
  user  User? @relation(fields: [created_by], references: [id])

  @@index([created_by])
  @@map("permissions")
}

model Archives {
  id        Int      @id @default(autoincrement())
  memo     String
  title      String
  register_number String
  date_exported_or_received      DateTime
  note      String
  file_number      Int
  archive_category  String
  type      ArchiveType @default(in)
  created_at     DateTime @default(now())
  created_by Int
  updated_at DateTime @updatedAt
  updated_by Int
  archived_created_by User? @relation("archived_created_by",fields: [created_by], references: [id], onUpdate: NoAction)
  archived_updated_by User? @relation("archived_updated_by",fields: [updated_by], references: [id], onUpdate: NoAction)

 @@index([created_by, title, register_number, date_exported_or_received])
 @@map("archives")

}

enum ArchiveType {
  in
  out
}

enum LicenseType {
  SMALL
  LARGE
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

model License {
  id            String        @id @default(uuid())
  licenseNumber String
  companyName   String
  licenseType   LicenseType
  issueDate     DateTime
  expiryDate    DateTime
  status        LicenseStatus
  province      String
  district      String
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  contracts     Contract[]

  @@map("licenses")
}

model Contract {
  id         String   @id @default(uuid())
  licenseId  String
  fileName   String
  fileUrl    String
  fileType   String
  uploadedBy String
  uploadedAt DateTime @default(now())

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

enum TenderType {
  TENDER
  CONSULTING
  AUCTION
  NOTICE
  ANNOUNCEMENT
  OTHER
}

enum TenderSector {
  MINING
  OIL
  GAS
  CONSULTING
  OTHER
}

enum TenderStatus {
  OPEN
  CLOSED
}

enum TenderActivityAction {
  VIEWED
  APPLIED
  IGNORED
  ASSIGNED
  NOTIFIED
}

enum TenderLanguage {
  EN
  PS
  FA
}

model Organization {
  id        Int      @id @default(autoincrement())
  name      String
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenders Tender[]

  @@map("organizations")
}

model Tender {
  id             String        @id @default(uuid())
  title          String
  description    String?       @db.Text
  sourceUrl      String        @unique
  referenceNo    String?
  publishDate    DateTime?
  closingDate    DateTime?
  sector         TenderSector  @default(OTHER)
  type           TenderType    @default(TENDER)
  status         TenderStatus  @default(OPEN)
  language       TenderLanguage @default(EN)
  projectName    String?
  location       String?
  attachments    Json?
  priorityScore  Float?
  organizationId Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  tags           TenderTag[]
  activities     TenderActivity[]

  @@index([status])
  @@index([closingDate])
  @@index([type])
  @@index([sector])
  @@index([publishDate])
  @@index([language])
  @@map("tenders")
}

model TenderTag {
  id       Int    @id @default(autoincrement())
  tenderId String
  tag      String

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([tag])
  @@map("tender_tags")
}

model TenderActivity {
  id        Int                  @id @default(autoincrement())
  tenderId  String
  action    TenderActivityAction
  userId    Int?
  notes     String?              @db.Text
  createdAt DateTime             @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([action])
  @@index([createdAt])
  @@map("tender_activity")
}

// ================================================================
//                EXECUTIVE DASHBOARD & MANUAL KPI MODULE
// ================================================================

enum KpiCategory {
  FINANCIAL
  CONTRACT
  TRAVEL
  OPERATIONAL
  OTHER
}

enum TravelType {
  DOMESTIC
  INTERNATIONAL
}

model DashboardKpi {
  id          Int         @id @default(autoincrement())
  key         String
  value       Float
  year        Int
  category    KpiCategory @default(OTHER)
  label       String?
  description String?     @db.Text
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([key, year])
  @@index([year])
  @@index([category])
  @@map("dashboard_kpis")
}

model ContractsSummary {
  id                  Int      @id @default(autoincrement())
  year                Int      @unique
  totalContracts      Int      @default(0)
  activeContracts     Int      @default(0)
  suspendedContracts  Int      @default(0)
  cancelledContracts  Int      @default(0)
  notes               String?  @db.Text
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([year])
  @@map("contracts_summary")
}

model MinisterTravel {
  id          Int        @id @default(autoincrement())
  type        TravelType
  destination String
  purpose     String?    @db.Text
  startDate   DateTime
  endDate     DateTime?
  cost        Float      @default(0)
  createdBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type])
  @@index([startDate])
  @@map("minister_travels")
}

// ================================================================
//         OFFICE EQUIPMENT / ASSET MANAGEMENT MODULE
// ================================================================

enum EquipmentCategory {
  LAPTOP
  DESKTOP
  PRINTER
  PHONE
  FURNITURE
  NETWORK
  MONITOR
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum EquipmentAssignmentStatus {
  ASSIGNED
  RETURNED
}

enum EquipmentMaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Equipment {
  id             Int                @id @default(autoincrement())
  name           String
  category       EquipmentCategory  @default(OTHER)
  brand          String?
  model          String?
  serialNumber   String?            @unique
  purchaseDate   DateTime?
  purchasePrice  Float              @default(0)
  warrantyExpiry DateTime?
  status         EquipmentStatus    @default(AVAILABLE)
  condition      EquipmentCondition @default(GOOD)
  warehouseId    Int?
  itemId         Int?
  notes          String?            @db.Text
  createdBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  assignments  EquipmentAssignment[]
  maintenances EquipmentMaintenance[]

  @@index([status])
  @@index([category])
  @@index([warrantyExpiry])
  @@index([serialNumber])
  @@map("equipment")
}

model EquipmentAssignment {
  id           Int                       @id @default(autoincrement())
  equipmentId  Int
  employeeId   Int
  employeeName String?
  assignedDate DateTime                  @default(now())
  returnDate   DateTime?
  status       EquipmentAssignmentStatus @default(ASSIGNED)
  remarks      String?                   @db.Text
  createdBy    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([employeeId])
  @@index([status])
  @@map("equipment_assignments")
}

model EquipmentMaintenance {
  id              Int                        @id @default(autoincrement())
  equipmentId     Int
  issue           String                     @db.Text
  cost            Float                      @default(0)
  maintenanceDate DateTime                   @default(now())
  completedDate   DateTime?
  vendor          String?
  status          EquipmentMaintenanceStatus @default(PENDING)
  notes           String?                    @db.Text
  createdBy       String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([status])
  @@index([maintenanceDate])
  @@map("equipment_maintenance")
}

// ================================================================
//                  EMPLOYEE (HR) MODULE
// ================================================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees Employee[]

  @@map("departments")
}

model Employee {
  id           Int            @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String?        @unique
  phone        String?
  departmentId Int?
  designation  String?
  hireDate     DateTime?
  status       EmployeeStatus @default(ACTIVE)
  profilePicture String?
  address      String?
  notes        String?        @db.Text
  createdBy    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([departmentId])
  @@index([firstName, lastName])
  @@map("employees")
}