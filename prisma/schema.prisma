// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
    seed     = "ts-node --transpile-only prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String?
  googleId        String? @unique
  profile_picture  String?
  isActive        Boolean  @default(true)
  roles           Role[]   @relation("UserRoles")
  permissions     Permission[]
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       Int?
  updated_by       Int?


  created_by_user User? @relation("UserCreatedBy", fields: [created_by], references: [id])
  updated_by_user User? @relation("UserUpdatedBy", fields: [updated_by], references: [id])


  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  created_roles    Role[] @relation("CreatedRoles")

  @@map("users") // This is optional, but if you want to map it to 'users', you can use this

}

model Role {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  description  String?
  permissions  Permission[] @relation("RolePermissions")
  users        User[]       @relation("UserRoles")
  created_by   Int
  created_at   DateTime     @default(now())

  created_by_user User @relation("CreatedRoles", fields: [created_by], references: [id])


  @@map("roles")
}

model Permission {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  group_name String
  label String
  roles Role[]  @relation("RolePermissions")
  created_at DateTime @default(now())

  created_by Int?
  user  User? @relation(fields: [created_by], references: [id])

  @@index([created_by])
  @@map("permissions")
}

enum LicenseType {
  SMALL_SCALE
  LARGE_SCALE
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}


model Company {
  id              String      @id @default(uuid())

  name            String
  licenseNumber   String      @unique
  TIN             String      @unique
  address         String

  createdAt       DateTime    @default(now())
  createdBy       Int?

  updatedAt       DateTime    @updatedAt
  updatedBy       Int?

  deletedBy       Int?

  owners          Owner[]
  miningLicense   MiningLicense[]

  @@map("companies")
}

model Owner {
  id              String      @id @default(uuid())

  name            String
  position        String
  shareAmount     Decimal     @db.Decimal(10, 2)

  companyId       String

  createdAt       DateTime    @default(now())
  createdBy       Int?

  updatedAt       DateTime    @updatedAt
  updatedBy       Int?

  deletedBy       Int?

  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@map("owners")
}

model MiningLicense {
  id              String          @id @default(uuid())

  companyId       String
  mieralTypeId    String
  licenseType     LicenseType     @default(SMALL_SCALE)
  status          LicenseStatus   @default(ACTIVE)

  issueDate       DateTime
  expiryDate      DateTime

  mineAddress         String

  createdBy       Int?
  createdAt       DateTime        @default(now())

  updatedAt       DateTime        @updatedAt
  updatedBy       Int?
  deletedBy       Int?

  mineralType     MineralType     @relation(fields: [mieralTypeId],references: [id], onDelete: Cascade)
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("licenses")
}

model Contract {
  id              String          @id @default(uuid())
  companyName     String

  status          ContractStatus  @default(ACTIVE)

  mieralTypeId     String     
  registrationNumber String?      @unique

  price           String
  priceCurrency   Currency? @default(AFN)
  royalty         Int?
  jobـopportunities Int?
  social_service_price  Int?
  social_service_currency Currency? @default(AFN)
  area            Int?
  unit            Unit? @default(Kilometre)
  mineAddress     String

  issueDate       DateTime
  expiryDate      DateTime

  createdBy       Int?
  createdAt       DateTime        @default(now())

  updatedAt       DateTime        @updatedAt
  updatedBy       Int?
  deletedBy       Int?

  mineralType     MineralType     @relation(fields: [mieralTypeId],references: [id], onDelete: Cascade)

  @@map("contracts")
}

model Auction{
  id            String     @id @default(uuid())
  mieralTypeId  String     
  round         String?
  mass          String
  unit          MassUnit  @default(Gram)
  unitPrice     String
  priceCurrency Currency  @default(AFN)
  royalty       Int?


  mineralType     MineralType     @relation(fields: [mieralTypeId],references: [id], onDelete: Cascade)

  @@map("auctions")
}

enum Unit{
  Kilometre
  Metre
  Hectares
}

enum MassUnit{
  Gram
  Kilogram
  Carat
}

enum Currency {
  AFN
  USD
}

model MineralType{
  id              String          @id @default(uuid())
  name            String          @unique
  mineralCategory MineralCategory @default(METALLIC)

  miningLicenses   MiningLicense[]
  contracts        Contract[]
  auctions         Auction[]

}

enum MineralCategory {
  METALLIC
  NONMETALLIC
}


// ================================================================
//                EXECUTIVE DASHBOARD & MANUAL KPI MODULE
// ================================================================

enum KpiCategory {
  FINANCIAL
  CONTRACT
  TRAVEL
  OPERATIONAL
  OTHER
}

enum TravelType {
  DOMESTIC
  INTERNATIONAL
}

model DashboardKpi {
  id          Int         @id @default(autoincrement())
  key         String
  value       Float
  year        Int
  category    KpiCategory @default(OTHER)
  label       String?
  description String?     @db.Text
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([key, year])
  @@index([year])
  @@index([category])
  @@map("dashboard_kpis")
}

model ContractsSummary {
  id                  Int      @id @default(autoincrement())
  year                Int      @unique
  totalContracts      Int      @default(0)
  activeContracts     Int      @default(0)
  suspendedContracts  Int      @default(0)
  cancelledContracts  Int      @default(0)
  notes               String?  @db.Text
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([year])
  @@map("contracts_summary")
}

model MinisterTravel {
  id          Int        @id @default(autoincrement())
  type        TravelType
  destination String
  purpose     String?    @db.Text
  startDate   DateTime
  endDate     DateTime?
  cost        Float      @default(0)
  createdBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([type])
  @@index([startDate])
  @@map("minister_travels")
}

// ================================================================
//         OFFICE EQUIPMENT / ASSET MANAGEMENT MODULE
// ================================================================

enum EquipmentCategory {
  LAPTOP
  DESKTOP
  PRINTER
  PHONE
  FURNITURE
  NETWORK
  MONITOR
  OTHER
}

enum EquipmentStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum EquipmentCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum EquipmentAssignmentStatus {
  ASSIGNED
  RETURNED
}

enum EquipmentMaintenanceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Equipment {
  id             Int                @id @default(autoincrement())
  name           String
  category       EquipmentCategory  @default(OTHER)
  brand          String?
  model          String?
  serialNumber   String?            @unique
  purchaseDate   DateTime?
  purchasePrice  Float              @default(0)
  warrantyExpiry DateTime?
  status         EquipmentStatus    @default(AVAILABLE)
  condition      EquipmentCondition @default(GOOD)
  warehouseId    Int?
  itemId         Int?
  notes          String?            @db.Text
  createdBy      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  assignments  EquipmentAssignment[]
  maintenances EquipmentMaintenance[]

  @@index([status])
  @@index([category])
  @@index([warrantyExpiry])
  @@index([serialNumber])
  @@map("equipment")
}

model EquipmentAssignment {
  id           Int                       @id @default(autoincrement())
  equipmentId  Int
  employeeId   Int
  employeeName String?
  assignedDate DateTime                  @default(now())
  returnDate   DateTime?
  status       EquipmentAssignmentStatus @default(ASSIGNED)
  remarks      String?                   @db.Text
  createdBy    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([employeeId])
  @@index([status])
  @@map("equipment_assignments")
}

model EquipmentMaintenance {
  id              Int                        @id @default(autoincrement())
  equipmentId     Int
  issue           String                     @db.Text
  cost            Float                      @default(0)
  maintenanceDate DateTime                   @default(now())
  completedDate   DateTime?
  vendor          String?
  status          EquipmentMaintenanceStatus @default(PENDING)
  notes           String?                    @db.Text
  createdBy       String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([status])
  @@index([maintenanceDate])
  @@map("equipment_maintenance")
}

// ================================================================
//                  EMPLOYEE (HR) MODULE
// ================================================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees Employee[]

  @@map("departments")
}

model Employee {
  id           Int            @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String?        @unique
  phone        String?
  departmentId Int?
  designation  String?
  hireDate     DateTime?
  status       EmployeeStatus @default(ACTIVE)
  profilePicture String?
  address      String?
  notes        String?        @db.Text
  createdBy    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([departmentId])
  @@index([firstName, lastName])
  @@map("employees")
}

model Province{
  id             Int                @id @default(autoincrement())
  name String? @unique

  @@map("provinces")
}