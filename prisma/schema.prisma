// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
    seed     = "ts-node --transpile-only prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String?
  googleId        String? @unique
  profile_picture  String?
  isActive        Boolean  @default(true)
  roles           Role[]   @relation("UserRoles")
  permissions     Permission[]
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt
  created_by       Int?
  updated_by       Int?


  created_by_user User? @relation("UserCreatedBy", fields: [created_by], references: [id])
  updated_by_user User? @relation("UserUpdatedBy", fields: [updated_by], references: [id])


  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  created_roles    Role[] @relation("CreatedRoles")

  @@map("users") // This is optional, but if you want to map it to 'users', you can use this

}

model Role {
  id           Int          @id @default(autoincrement())
  name         String       @unique
  description  String?
  permissions  Permission[] @relation("RolePermissions")
  users        User[]       @relation("UserRoles")
  created_by   Int
  created_at   DateTime     @default(now())

  created_by_user User @relation("CreatedRoles", fields: [created_by], references: [id])


  @@map("roles")
}

model Permission {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  group_name String
  label String
  roles Role[]  @relation("RolePermissions")
  created_at DateTime @default(now())

  created_by Int?
  user  User? @relation(fields: [created_by], references: [id])

  @@index([created_by])
  @@map("permissions")
}

// ================================================================
//                     INVENTORY MANAGEMENT MODULE
// ================================================================

enum ItemCategory {
  OFFICE_SUPPLIES
  IT_EQUIPMENT
  PROJECT_MATERIALS
  CONSUMABLES
  ASSETS
  OTHER
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum StockMovementReference {
  PURCHASE
  SALE
  MANUAL
  TRANSFER
  ADJUSTMENT
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model Item {
  id            Int          @id @default(autoincrement())
  name          String
  sku           String?      @unique
  category      ItemCategory @default(OTHER)
  unit          String       @default("pcs")
  description   String?      @db.Text
  minStock      Float        @default(0)
  salePrice     Float        @default(0)
  purchasePrice Float        @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  stocks        InventoryStock[]
  movements     StockMovement[]
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]

  @@index([category])
  @@index([name])
  @@map("items")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks         InventoryStock[]
  sourceMovements StockMovement[] @relation("SourceWarehouse")
  targetMovements StockMovement[] @relation("TargetWarehouse")

  @@map("warehouses")
}

model InventoryStock {
  id          Int      @id @default(autoincrement())
  itemId      Int
  warehouseId Int
  quantity    Float    @default(0)
  updatedAt   DateTime @updatedAt

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@index([warehouseId])
  @@map("inventory_stock")
}

model StockMovement {
  id                Int                    @id @default(autoincrement())
  itemId            Int
  type              StockMovementType
  quantity          Float
  sourceWarehouseId Int?
  targetWarehouseId Int?
  referenceType     StockMovementReference @default(MANUAL)
  referenceId       Int?
  purchaseId        Int?
  userId            Int?
  notes             String?                @db.Text
  createdAt         DateTime               @default(now())

  item             Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sourceWarehouse  Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  targetWarehouse  Warehouse? @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: SetNull)
  purchase         Purchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
  @@index([purchaseId])
  @@map("stock_movements")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  totalOwed Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  payments  SupplierPayment[]

  @@map("suppliers")
}

model Purchase {
  id              Int            @id @default(autoincrement())
  supplierId      Int?
  referenceNo     String?
  totalAmount     Float          @default(0)
  paidAmount      Float          @default(0)
  remainingAmount Float          @default(0)
  paymentStatus   PaymentStatus  @default(UNPAID)
  purchaseDate    DateTime       @default(now())
  status          PurchaseStatus @default(PENDING)
  notes           String?        @db.Text
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  supplier  Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items     PurchaseItem[]
  movements StockMovement[]
  payments  SupplierPayment[]

  @@index([supplierId])
  @@index([status])
  @@index([paymentStatus])
  @@index([purchaseDate])
  @@map("purchases")
}

model SupplierPayment {
  id          Int           @id @default(autoincrement())
  supplierId  Int
  purchaseId  Int?
  amount      Float
  method      PaymentMethod @default(CASH)
  paymentDate DateTime      @default(now())
  referenceNo String?
  notes       String?       @db.Text
  createdBy   String?
  createdAt   DateTime      @default(now())

  supplier Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([supplierId])
  @@index([purchaseId])
  @@index([paymentDate])
  @@map("supplier_payments")
}

model PurchaseItem {
  id         Int   @id @default(autoincrement())
  purchaseId Int
  itemId     Int
  quantity   Float
  price      Float @default(0)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([itemId])
  @@map("purchase_items")
}

// ================================================================
//                  EMPLOYEE (HR) MODULE
// ================================================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Department {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employees Employee[]

  @@map("departments")
}

model Employee {
  id           Int            @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String?        @unique
  phone        String?
  departmentId Int?
  designation  String?
  hireDate     DateTime?
  status       EmployeeStatus @default(ACTIVE)
  profilePicture String?
  address      String?
  notes        String?        @db.Text
  createdBy    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sales      Sale[]
  payments   Payment[]

  @@index([status])
  @@index([departmentId])
  @@index([firstName, lastName])
  @@map("employees")
}

// ================================================================
//             SALES / BILLING / PAYMENTS MODULE
// ================================================================

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE
  CREDIT
  OTHER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  creditLimit Float    @default(0)
  totalOwed   Float    @default(0)
  notes       String?  @db.Text
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sales Sale[]

  @@index([name])
  @@index([phone])
  @@map("customers")
}

model Sale {
  id              Int           @id @default(autoincrement())
  invoiceNo       String        @unique
  customerId      Int?
  warehouseId     Int
  employeeId      Int?
  subtotal        Float         @default(0)
  discount        Float         @default(0)
  tax             Float         @default(0)
  totalAmount     Float         @default(0)
  paidAmount      Float         @default(0)
  remainingAmount Float         @default(0)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod @default(CASH)
  saleStatus      SaleStatus    @default(COMPLETED)
  saleDate        DateTime      @default(now())
  dueDate         DateTime?
  notes           String?       @db.Text
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  employee Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  payments Payment[]

  @@index([invoiceNo])
  @@index([customerId])
  @@index([employeeId])
  @@index([paymentStatus])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id        Int   @id @default(autoincrement())
  saleId    Int
  itemId    Int
  quantity  Float
  unitPrice Float @default(0)
  discount  Float @default(0)
  lineTotal Float @default(0)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([itemId])
  @@map("sale_items")
}

model Payment {
  id            Int           @id @default(autoincrement())
  saleId        Int
  amount        Float
  method        PaymentMethod @default(CASH)
  paymentDate   DateTime      @default(now())
  referenceNo   String?
  notes         String?       @db.Text
  employeeId    Int?
  createdBy     String?
  createdAt     DateTime      @default(now())

  sale     Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([employeeId])
  @@index([paymentDate])
  @@map("payments")
}
