// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
  seed     = "ts-node --transpile-only prisma/seed.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  COMPANY_USER
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String?  @unique
  isActive  Boolean  @default(true)
  timezone  String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  items            Item[]
  warehouses       Warehouse[]
  inventoryStocks  InventoryStock[]
  stockMovements   StockMovement[]
  inventoryBatches InventoryBatch[]
  alerts           Alert[]
  stockCounts      StockCount[]
  stockCountLines  StockCountLine[]
  categories       Category[]
  suppliers        Supplier[]
  purchases        Purchase[]
  purchaseItems    PurchaseItem[]
  supplierPayments SupplierPayment[]
  customers        Customer[]
  sales            Sale[]
  saleItems        SaleItem[]
  payments         Payment[]
  employees        Employee[]
  departments      Department[]
  auditLogs        AuditLog[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  journalLines     JournalLine[]
  bankAccounts     BankAccount[]
  bankTransactions BankTransaction[]
  reconciliations  Reconciliation[]

  subscriptions      CompanySubscription[]
  planChangeRequests PlanChangeRequest[]

  @@map("companies")
}

// ================================================================
//                       SUBSCRIPTION LAYER
// Plans (global) + per-company subscriptions (tenant-scoped). A
// Plan owns a fixed set of ModuleCode/FeatureCode enables plus an
// optional row-count limit. Every Company has at most one ACTIVE
// CompanySubscription at a time; the SubscriptionsService enforces
// this at the service layer (Prisma can't express partial
// uniqueness). Plans/PlanModule/PlanFeature/PlanLimit are NOT in
// TENANT_MODELS — they are global config. Only CompanySubscription
// is tenant-scoped and auto-injected with companyId by the Prisma
// extension.
// ================================================================
enum ModuleCode {
  INVENTORY
  SALES
  EMPLOYEES
  CATEGORIES
  ALERTS
  STOCK_COUNTS
  ACCOUNTING
  BANKING
  USERS
  ROLES
}

enum FeatureCode {
  INVENTORY_REPORTS
  INVENTORY_PROFIT_REPORT
  SALES_PDF_EXPORT
  CUSTOMER_STATEMENT_PDF
  ACCOUNTING_LEDGER
  ACCOUNTING_JOURNALS
  BANK_RECONCILIATION
  AUDIT_LOGS
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAST_DUE
}

/**
 * Billing cadence chosen at upgrade-time. Drives the auto-computed
 * `endDate`:
 *   - MONTHLY   → endDate = startDate + 1 month
 *   - YEARLY    → endDate = startDate + 1 year
 *   - PERPETUAL → endDate = null (free tiers / open-ended admin grants)
 */
enum BillingCycle {
  MONTHLY
  YEARLY
  PERPETUAL
}

enum PlanChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Plan {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  monthlyPrice Float    @default(0)
  yearlyPrice  Float    @default(0)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  modules       PlanModule[]
  features      PlanFeature[]
  limit         PlanLimit?
  subscriptions CompanySubscription[]

  requestedInChanges PlanChangeRequest[] @relation("RequestedPlan")
  currentInChanges   PlanChangeRequest[] @relation("CurrentPlan")

  @@index([isActive, sortOrder])
  @@index([deletedAt])
  @@map("plans")
}

model PlanModule {
  id         Int        @id @default(autoincrement())
  planId     Int
  moduleCode ModuleCode

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleCode])
  @@index([moduleCode])
  @@map("plan_modules")
}

model PlanFeature {
  id          Int         @id @default(autoincrement())
  planId      Int
  featureCode FeatureCode

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureCode])
  @@index([featureCode])
  @@map("plan_features")
}

model PlanLimit {
  id            Int  @id @default(autoincrement())
  planId        Int  @unique
  maxUsers      Int?
  maxWarehouses Int?
  maxItems      Int?
  maxEmployees  Int?
  storageGb     Int?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_limits")
}

model CompanySubscription {
  id           Int                @id @default(autoincrement())
  companyId    Int
  planId       Int
  startDate    DateTime           @default(now())
  endDate      DateTime?
  status       SubscriptionStatus @default(ACTIVE)
  billingCycle BillingCycle       @default(PERPETUAL)
  autoRenew    Boolean            @default(true)
  notes     String?            @db.Text
  createdBy String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  deletedAt DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([companyId])
  @@index([status])
  @@index([endDate])
  @@index([deletedAt])
  @@map("company_subscriptions")
}

// ────────────────────────────────────────────────────────────────
// Plan upgrade/downgrade requests. A company admin submits a request
// (selecting a target plan, billing cycle, optional payment receipt
// and notes); a SUPER_ADMIN or anyone granted the
// `plan_request.review` permission approves or rejects it. Approval
// calls SubscriptionsService.changePlanForCompany immediately.
//
// Single-pending invariant (at-most-one PENDING per company) is
// enforced at the service layer: create() checks for an existing
// pending row first. We don't add a partial unique index because the
// app-layer check needs to return a friendly 409, not a Postgres
// constraint error.
// ────────────────────────────────────────────────────────────────
model PlanChangeRequest {
  id              Int                     @id @default(autoincrement())
  companyId       Int
  requestedPlanId Int
  currentPlanId   Int?
  billingCycle    BillingCycle            @default(MONTHLY)

  receiptUrl      String?
  receiptFileName String?

  notes           String?                 @db.Text
  status          PlanChangeRequestStatus @default(PENDING)

  reviewedById    Int?
  reviewedAt      DateTime?
  reviewNotes     String?                 @db.Text

  createdById     Int?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestedPlan Plan    @relation("RequestedPlan", fields: [requestedPlanId], references: [id], onDelete: Restrict)
  currentPlan   Plan?   @relation("CurrentPlan", fields: [currentPlanId], references: [id], onDelete: SetNull)
  reviewedBy    User?   @relation("ReviewedPlanRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdBy     User?   @relation("CreatedPlanRequests", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@map("plan_change_requests")
}

// ================================================================
//                          AUDIT LOG
// Persistent, append-only record of every meaningful action: every
// write to a tracked tenant model, every login, every SUPER_ADMIN
// tenant scope change, every cross-tenant write that was blocked.
//
// `companyId` is nullable so system-level events (e.g. company
// creation by a SUPER_ADMIN with no current tenant scope) still get
// logged.
//
// `before` / `after` are JSON snapshots; we only populate them for
// low-frequency writes (writes to Sale, Customer, Item, etc.) — the
// hot stock-movement path skips diffs to avoid doubling DB load.
// ================================================================
// ================================================================
//                       ACCOUNTING LAYER (§5.1)
// Double-entry general ledger. Every business event (sale, purchase,
// payment) emits a balanced `JournalEntry` whose `JournalLine` rows
// sum (Σ debits = Σ credits). Reports (P&L, balance sheet, trial
// balance) are then "select sum(debit) - sum(credit) from
// journal_lines where accountId = ..." aggregates.
// ================================================================
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id        Int         @id @default(autoincrement())
  companyId Int
  code      String
  name      String
  type      AccountType
  parentId  Int?
  isActive  Boolean     @default(true)
  notes     String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Account?      @relation("AccountParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Account[]     @relation("AccountParent")
  lines    JournalLine[]

  deletedAt DateTime?

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, type])
  @@index([parentId])
  @@index([deletedAt])
  @@map("accounts")
}

model JournalEntry {
  id          Int       @id @default(autoincrement())
  companyId   Int
  entryNo     String
  date        DateTime
  description String
  sourceType  String?
  sourceId    Int?
  isLocked    Boolean   @default(false)
  lockedAt    DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines   JournalLine[]

  deletedAt DateTime?

  @@unique([companyId, entryNo])
  @@index([companyId])
  @@index([companyId, date])
  @@index([sourceType, sourceId])
  @@index([deletedAt])
  @@map("journal_entries")
}

model JournalLine {
  id             Int     @id @default(autoincrement())
  journalEntryId Int
  accountId      Int
  companyId      Int
  debit          Float   @default(0)
  credit         Float   @default(0)
  description    String?

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([journalEntryId])
  @@index([accountId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("journal_lines")
}

// ================================================================
//                  BANK RECONCILIATION MODULE (§5.2)
// Workflow:
//   1. Operator imports a bank statement → creates BankTransaction rows.
//   2. Operator (or scheduled job) runs auto-match: link bank rows to
//      Payment (incoming) / SupplierPayment (outgoing) by amount +
//      date window + reference.
//   3. Unmatched rows go to a manual matcher UI.
//   4. Operator closes the reconciliation for the period, locking it.
// ================================================================
enum BankTransactionDirection {
  CREDIT // money INTO the bank account
  DEBIT  // money OUT of the bank account
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum ReconciliationStatus {
  OPEN
  COMPLETED
}

model BankAccount {
  id             Int      @id @default(autoincrement())
  companyId      Int
  name           String
  accountNumber  String?
  currency       String   @default("USD")
  provider       String?
  openingBalance Float    @default(0)
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions    BankTransaction[]
  reconciliations Reconciliation[]

  deletedAt DateTime?

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
  @@map("bank_accounts")
}

model BankTransaction {
  id                       Int                      @id @default(autoincrement())
  companyId                Int
  bankAccountId            Int
  statementDate            DateTime
  direction                BankTransactionDirection
  amount                   Float
  description              String?
  reference                String?
  raw                      Json?
  status                   BankTransactionStatus    @default(UNMATCHED)
  matchedPaymentId         Int?
  matchedSupplierPaymentId Int?
  matchedAt                DateTime?
  matchedBy                String?
  importedAt               DateTime                 @default(now())

  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount            BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  matchedPayment         Payment?         @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)
  matchedSupplierPayment SupplierPayment? @relation(fields: [matchedSupplierPaymentId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  @@index([companyId])
  @@index([bankAccountId])
  @@index([statementDate])
  @@index([status])
  @@index([matchedPaymentId])
  @@index([matchedSupplierPaymentId])
  @@index([companyId, status, statementDate])
  @@index([deletedAt])
  @@map("bank_transactions")
}

model Reconciliation {
  id             Int                  @id @default(autoincrement())
  companyId      Int
  bankAccountId  Int
  periodStart    DateTime
  periodEnd      DateTime
  status         ReconciliationStatus @default(OPEN)
  openingBalance Float
  closingBalance Float
  notes          String?              @db.Text
  createdBy      String?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([companyId])
  @@index([bankAccountId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([deletedAt])
  @@map("reconciliations")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  companyId Int?
  userId    Int?
  email     String?
  action    String
  entity    String?
  entityId  Int?
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  requestId String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model User {
  id              Int          @id @default(autoincrement())
  name            String
  email           String       @unique
  password        String?
  googleId        String?      @unique
  profile_picture String?
  isActive        Boolean      @default(true)
  userRole        UserRole     @default(COMPANY_USER)
  companyId       Int?
  roles           Role[]       @relation("UserRoles")
  permissions     Permission[]
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt
  created_by      Int?
  updated_by      Int?

  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  created_by_user User?    @relation("UserCreatedBy", fields: [created_by], references: [id])
  updated_by_user User?    @relation("UserUpdatedBy", fields: [updated_by], references: [id])

  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  created_roles Role[] @relation("CreatedRoles")

  createdPlanRequests  PlanChangeRequest[] @relation("CreatedPlanRequests")
  reviewedPlanRequests PlanChangeRequest[] @relation("ReviewedPlanRequests")

  @@index([companyId])
  @@map("users")
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  permissions Permission[] @relation("RolePermissions")
  users       User[]       @relation("UserRoles")
  created_by  Int
  created_at  DateTime     @default(now())

  created_by_user User @relation("CreatedRoles", fields: [created_by], references: [id])

  @@map("roles")
}

model Permission {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  group_name String
  label      String
  roles      Role[]   @relation("RolePermissions")
  created_at DateTime @default(now())

  created_by Int?
  user       User? @relation(fields: [created_by], references: [id])

  @@index([created_by])
  @@map("permissions")
}

// ================================================================
//                     INVENTORY MANAGEMENT MODULE
// ================================================================

enum ItemCategory {
  OFFICE_SUPPLIES
  IT_EQUIPMENT
  PROJECT_MATERIALS
  CONSUMABLES
  ASSETS
  OTHER
}

enum StockMovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
}

enum StockMovementReference {
  PURCHASE
  SALE
  MANUAL
  TRANSFER
  ADJUSTMENT
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum AlertType {
  LOW_STOCK
  OVERSTOCK
  DEAD_STOCK
  REORDER
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum StockCountStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String?
  description String?  @db.Text
  parentId    Int?
  companyId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryParent")
  items    Item[]

  deletedAt DateTime?

  @@unique([companyId, parentId, name])
  @@unique([companyId, slug])
  @@index([parentId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("categories")
}

model Item {
  id              Int          @id @default(autoincrement())
  name            String
  sku             String?
  category        ItemCategory @default(OTHER)
  categoryId      Int?
  companyId       Int
  unit            String       @default("pcs")
  description     String?      @db.Text
  minStock        Float        @default(0)
  maxStock        Float?
  reorderPoint    Float?
  reorderQuantity Float?
  leadTimeDays    Int?
  salePrice       Float        @default(0)
  purchasePrice   Float        @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryRef     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stocks          InventoryStock[]
  movements       StockMovement[]
  purchaseItems   PurchaseItem[]
  saleItems       SaleItem[]
  batches         InventoryBatch[]
  alerts          Alert[]
  stockCountLines StockCountLine[]

  deletedAt DateTime?

  @@unique([companyId, sku])
  @@index([category])
  @@index([categoryId])
  @@index([companyId])
  @@index([name])
  @@index([deletedAt])
  // Item-list search + filter sorts by name within the tenant.
  @@index([companyId, name])
  @@map("items")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stocks          InventoryStock[]
  sourceMovements StockMovement[]  @relation("SourceWarehouse")
  targetMovements StockMovement[]  @relation("TargetWarehouse")
  batches         InventoryBatch[]
  alerts          Alert[]
  stockCounts     StockCount[]

  deletedAt DateTime?

  @@index([companyId])
  @@index([deletedAt])
  @@map("warehouses")
}

model InventoryStock {
  id          Int      @id @default(autoincrement())
  itemId      Int
  warehouseId Int
  companyId   Int
  quantity    Float    @default(0)
  version     Int      @default(0)
  updatedAt   DateTime @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@index([warehouseId])
  @@index([companyId])
  @@index([deletedAt])
  // Tenant-scoped per-item stock aggregates (used in low-stock + dead-stock
  // subqueries) benefit from a companyId-first composite.
  @@index([companyId, itemId])
  @@map("inventory_stock")
}

model InventoryBatch {
  id          Int       @id @default(autoincrement())
  itemId      Int
  warehouseId Int
  companyId   Int
  batchNo     String?
  quantity    Float     @default(0)
  unitCost    Float     @default(0)
  receivedAt  DateTime  @default(now())
  expiryDate  DateTime?
  purchaseId  Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  purchase  Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  @@index([itemId, warehouseId])
  @@index([receivedAt])
  @@index([expiryDate])
  @@index([purchaseId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("inventory_batches")
}

model StockMovement {
  id                Int                    @id @default(autoincrement())
  itemId            Int
  companyId         Int
  type              StockMovementType
  quantity          Float
  unitCost          Float?
  batchId           Int?
  sourceWarehouseId Int?
  targetWarehouseId Int?
  referenceType     StockMovementReference @default(MANUAL)
  referenceId       Int?
  purchaseId        Int?
  userId            Int?
  idempotencyKey    String?                @unique
  notes             String?                @db.Text
  createdAt         DateTime               @default(now())

  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item            Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sourceWarehouse Warehouse? @relation("SourceWarehouse", fields: [sourceWarehouseId], references: [id], onDelete: SetNull)
  targetWarehouse Warehouse? @relation("TargetWarehouse", fields: [targetWarehouseId], references: [id], onDelete: SetNull)
  purchase        Purchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  @@index([itemId])
  @@index([type])
  @@index([createdAt])
  @@index([purchaseId])
  @@index([referenceType, referenceId])
  @@index([companyId])
  @@index([deletedAt])
  // Composite indexes for the heavy raw SQL in inventory reports:
  //  - dead-stock + monthly-usage scans filter by companyId + type + createdAt.
  //  - last-OUT-per-item lookups filter by companyId + itemId + createdAt.
  //  - sale-COGS joins filter by companyId + (referenceType, referenceId).
  @@index([companyId, type, createdAt])
  @@index([companyId, itemId, createdAt])
  @@index([companyId, referenceType, referenceId])
  @@map("stock_movements")
}

model Alert {
  id           Int         @id @default(autoincrement())
  type         AlertType
  status       AlertStatus @default(OPEN)
  itemId       Int
  warehouseId  Int?
  companyId    Int
  message      String      @db.Text
  threshold    Float?
  currentValue Float?
  metadata     Json?
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
  /// First time the alert was dispatched to any notification channel.
  /// `dispatchOpen()` skips alerts where this is set so cron re-runs
  /// don't double-notify (§5.3).
  dispatchedAt DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item      Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  @@index([type])
  @@index([status])
  @@index([itemId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([companyId])
  @@index([deletedAt])
  @@index([companyId, status, dispatchedAt])
  @@map("alerts")
}

model StockCount {
  id          Int              @id @default(autoincrement())
  reference   String?
  warehouseId Int
  companyId   Int
  status      StockCountStatus @default(DRAFT)
  notes       String?          @db.Text
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  createdBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines     StockCountLine[]

  deletedAt DateTime?

  @@unique([companyId, reference])
  @@index([warehouseId])
  @@index([status])
  @@index([startedAt])
  @@index([companyId])
  @@index([deletedAt])
  @@map("stock_counts")
}

model StockCountLine {
  id           Int     @id @default(autoincrement())
  stockCountId Int
  itemId       Int
  companyId    Int
  expectedQty  Float   @default(0)
  countedQty   Float   @default(0)
  variance     Float   @default(0)
  notes        String? @db.Text

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  item       Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@unique([stockCountId, itemId])
  @@index([stockCountId])
  @@index([itemId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("stock_count_lines")
}

model Supplier {
  id        Int      @id @default(autoincrement())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  totalOwed Float    @default(0)
  companyId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  payments  SupplierPayment[]

  deletedAt DateTime?

  @@index([companyId])
  @@index([deletedAt])
  @@map("suppliers")
}

model Purchase {
  id              Int            @id @default(autoincrement())
  supplierId      Int?
  companyId       Int
  referenceNo     String?
  totalAmount     Float          @default(0)
  paidAmount      Float          @default(0)
  remainingAmount Float          @default(0)
  paymentStatus   PaymentStatus  @default(UNPAID)
  purchaseDate    DateTime       @default(now())
  status          PurchaseStatus @default(PENDING)
  notes           String?        @db.Text
  createdBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier  Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items     PurchaseItem[]
  movements StockMovement[]
  payments  SupplierPayment[]
  batches   InventoryBatch[]

  deletedAt DateTime?

  @@index([supplierId])
  @@index([status])
  @@index([paymentStatus])
  @@index([purchaseDate])
  @@index([companyId])
  @@index([deletedAt])
  // Sales-report "purchases by period" aggregate + AP dashboard both
  // filter by tenant + status + purchaseDate.
  @@index([companyId, status, purchaseDate])
  @@map("purchases")
}

model SupplierPayment {
  id          Int           @id @default(autoincrement())
  supplierId  Int
  purchaseId  Int?
  companyId   Int
  amount      Float
  method      PaymentMethod @default(CASH)
  paymentDate DateTime      @default(now())
  referenceNo String?
  notes       String?       @db.Text
  createdBy   String?
  createdAt   DateTime      @default(now())

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  purchase         Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  bankTransactions BankTransaction[]

  deletedAt DateTime?

  @@index([supplierId])
  @@index([purchaseId])
  @@index([paymentDate])
  @@index([companyId])
  @@index([deletedAt])
  @@map("supplier_payments")
}

model PurchaseItem {
  id         Int   @id @default(autoincrement())
  purchaseId Int
  itemId     Int
  companyId  Int
  quantity   Float
  price      Float @default(0)

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item     Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  deletedAt DateTime?

  @@index([purchaseId])
  @@index([itemId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("purchase_items")
}

// ================================================================
//                  EMPLOYEE (HR) MODULE
// ================================================================

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  companyId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employees Employee[]

  deletedAt DateTime?

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
  @@map("departments")
}

model Employee {
  id             Int            @id @default(autoincrement())
  firstName      String
  lastName       String
  email          String?
  phone          String?
  departmentId   Int?
  companyId      Int
  designation    String?
  hireDate       DateTime?
  status         EmployeeStatus @default(ACTIVE)
  profilePicture String?
  address        String?
  notes          String?        @db.Text
  createdBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sales      Sale[]
  payments   Payment[]

  deletedAt DateTime?

  @@unique([companyId, email])
  @@index([status])
  @@index([departmentId])
  @@index([firstName, lastName])
  @@index([companyId])
  @@index([deletedAt])
  @@map("employees")
}

// ================================================================
//             SALES / BILLING / PAYMENTS MODULE
// ================================================================

enum PaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE
  CREDIT
  OTHER
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Customer {
  id          Int      @id @default(autoincrement())
  name        String
  phone       String?
  email       String?
  address     String?
  companyId   Int
  creditLimit Float    @default(0)
  totalOwed   Float    @default(0)
  notes       String?  @db.Text
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales   Sale[]

  deletedAt DateTime?

  @@index([name])
  @@index([phone])
  @@index([companyId])
  @@index([deletedAt])
  // Customer-list search sorted by createdAt is tenant-scoped.
  @@index([companyId, name])
  @@map("customers")
}

model Sale {
  id              Int           @id @default(autoincrement())
  invoiceNo       String
  customerId      Int?
  warehouseId     Int
  employeeId      Int?
  companyId       Int
  subtotal        Float         @default(0)
  discount        Float         @default(0)
  tax             Float         @default(0)
  totalAmount     Float         @default(0)
  paidAmount      Float         @default(0)
  remainingAmount Float         @default(0)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentMethod   PaymentMethod @default(CASH)
  saleStatus      SaleStatus    @default(COMPLETED)
  saleDate        DateTime      @default(now())
  dueDate         DateTime?
  notes           String?       @db.Text
  createdBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  employee Employee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  items    SaleItem[]
  payments Payment[]

  deletedAt DateTime?

  @@unique([companyId, invoiceNo])
  @@index([invoiceNo])
  @@index([customerId])
  @@index([employeeId])
  @@index([paymentStatus])
  @@index([saleDate])
  @@index([companyId])
  @@index([deletedAt])
  // Composite indexes for hot report paths. Every report filters by
  // tenant first, so leading with companyId lets these indexes also
  // satisfy companyId-only queries via left-prefix scan.
  @@index([companyId, saleDate])
  @@index([companyId, paymentStatus, dueDate])
  @@index([companyId, customerId, saleDate])
  @@index([companyId, saleStatus, saleDate])
  @@map("sales")
}

model SaleItem {
  id        Int   @id @default(autoincrement())
  saleId    Int
  itemId    Int
  companyId Int
  quantity  Float
  unitPrice Float @default(0)
  discount  Float @default(0)
  lineTotal Float @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Restrict)

  deletedAt DateTime?

  @@index([saleId])
  @@index([itemId])
  @@index([companyId])
  @@index([deletedAt])
  @@map("sale_items")
}

model Payment {
  id          Int           @id @default(autoincrement())
  saleId      Int
  companyId   Int
  amount      Float
  method      PaymentMethod @default(CASH)
  paymentDate DateTime      @default(now())
  referenceNo String?
  notes       String?       @db.Text
  employeeId  Int?
  createdBy   String?
  createdAt   DateTime      @default(now())

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale             Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  employee         Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  bankTransactions BankTransaction[]

  deletedAt DateTime?

  @@index([saleId])
  @@index([employeeId])
  @@index([paymentDate])
  @@index([companyId])
  @@index([deletedAt])
  // Dashboard "cash received this month / period" aggregates filter
  // by companyId + paymentDate range.
  @@index([companyId, paymentDate])
  @@map("payments")
}
